file(GLOB_RECURSE inputs LIST_DIRECTORIES false
    "${SOURCE_DIR}/Main/*.c" "${SOURCE_DIR}/Main/*.h"
    "${SOURCE_DIR}/Boards/F405/*" "${SOURCE_DIR}/Core/*.c" "${SOURCE_DIR}/Core/*.h"
    "${SOURCE_DIR}/Drivers/*.c" "${SOURCE_DIR}/Drivers/*.h" "${SOURCE_DIR}/cmake/*.cmake")
list(APPEND inputs "${SOURCE_DIR}/CMakeLists.txt" "${SOURCE_DIR}/startup_stm32f405xx.s")
list(SORT inputs)
set(fingerprint "${IDENTITY_CONFIG}")
foreach(path IN LISTS inputs)
    file(SHA256 "${path}" hash)
    file(RELATIVE_PATH relative "${SOURCE_DIR}" "${path}")
    string(APPEND fingerprint "\n${relative}:${hash}")
endforeach()
execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY "${SOURCE_DIR}"
    OUTPUT_VARIABLE git_id OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE git_result)
if(NOT git_result EQUAL 0)
    set(git_id "0000000000000000000000000000000000000000")
endif()
execute_process(COMMAND git diff --quiet HEAD -- Main Boards Core Drivers cmake CMakeLists.txt CMakePresets.json
    WORKING_DIRECTORY "${SOURCE_DIR}" RESULT_VARIABLE dirty)
if(NOT dirty EQUAL 0)
    set(dirty 1)
endif()
string(APPEND fingerprint "\n${git_id}:${dirty}")
string(SHA256 firmware_id "${fingerprint}")
string(REGEX REPLACE "(..)" "0x\\1," id_bytes "${firmware_id}")
string(REGEX REPLACE "(..)" "0x\\1," git_bytes "${git_id}")
set(content "#define DEBUG_FIRMWARE_ID_BYTES {${id_bytes}}\n#define DEBUG_GIT_ID_BYTES {${git_bytes}}\n#define DEBUG_SOURCE_DIRTY ${dirty}\n#define DEBUG_FIRMWARE_ID_HEX \"${firmware_id}\"\n")
set(old "")
if(EXISTS "${OUTPUT_FILE}")
    file(READ "${OUTPUT_FILE}" old)
endif()
if(NOT content STREQUAL old)
    file(WRITE "${OUTPUT_FILE}" "${content}")
endif()
