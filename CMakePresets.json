{
    "version": 3,
    "configurePresets": [
        {
            "name": "f405",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/F405/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "F405_PROFILE": "${presetName}",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "MotionDebug",
            "inherits": "f405",
            "cacheVariables": {
                "APP_AUTO_BACKUP": "OFF"
            }
        },
        {
            "name": "NormalRun",
            "inherits": "f405"
        }
    ],
    "buildPresets": [
        {
            "name": "MotionDebug",
            "configurePreset": "MotionDebug"
        },
        {
            "name": "NormalRun",
            "configurePreset": "NormalRun"
        }
    ]
}
