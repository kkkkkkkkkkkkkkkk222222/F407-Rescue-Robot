{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {}
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "MotionDebug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "APP_ACTIVE_MODE_OVERRIDE": "APP_MODE_MOTION_DEBUG_TASK"
            }
        },
        {
            "name": "WheelCheck",
            "inherits": "MotionDebug",
            "cacheVariables": {
                "APP_ENABLE_WHEEL_CHECK": "ON"
            }
        },
        {
            "name": "NormalRun",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "APP_ACTIVE_MODE_OVERRIDE": "APP_MODE_RESCUE_TASK"
            }
        },
        {
            "name": "Gamepad",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "APP_ACTIVE_MODE_OVERRIDE": "APP_MODE_GAMEPAD_TASK"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "MotionDebug",
            "configurePreset": "MotionDebug"
        },
        {
            "name": "WheelCheck",
            "configurePreset": "WheelCheck"
        },
        {
            "name": "NormalRun",
            "configurePreset": "NormalRun"
        },
        {
            "name": "Gamepad",
            "configurePreset": "Gamepad"
        }
    ]
}
