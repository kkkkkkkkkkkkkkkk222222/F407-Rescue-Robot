+static bool task_bulldozer_live_step(uint8_t step)
+{
+  return step == VISION_BULLDOZER_BACK_TO_SWEEP ||
+      step == VISION_BULLDOZER_LEFT_TO_SWEEP ||
+      step == VISION_BULLDOZER_BACK_TO_STAGE ||
+      step == VISION_BULLDOZER_RIGHT_TO_STAGE;
+}
