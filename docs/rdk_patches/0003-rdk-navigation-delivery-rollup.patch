diff --git a/vision/rescue_vision/mission_protocol.py b/vision/rescue_vision/mission_protocol.py
index ea8468f..c2d58b0 100644
--- a/vision/rescue_vision/mission_protocol.py
+++ b/vision/rescue_vision/mission_protocol.py
@@ -27,6 +27,7 @@ STM_CLAW_VISIBLE = 1 << 0
 STM_GRIPPER_CLOSED = 1 << 1
 STM_MOTORS_ACTIVE = 1 << 2
 STM_AUTO_APPROACH = 1 << 3
+STM_DISTANCE_DONE = 1 << 5
 STM_FAULT = 1 << 7
 
 
@@ -83,6 +84,10 @@ class Stm32Status:
     def gripper_closed(self) -> bool:
         return bool(self.flags & STM_GRIPPER_CLOSED)
 
+    @property
+    def distance_done(self) -> bool:
+        return bool(self.flags & STM_DISTANCE_DONE)
+
     @property
     def fault(self) -> bool:
         return bool(self.flags & STM_FAULT) or self.fault_code != 0
