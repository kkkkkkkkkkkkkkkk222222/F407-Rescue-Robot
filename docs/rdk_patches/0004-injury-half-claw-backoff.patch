diff --git a/competition_rescue/tests/test_injury_backoff.py b/competition_rescue/tests/test_injury_backoff.py
new file mode 100644
index 0000000..c3a87c2
--- /dev/null
+++ b/competition_rescue/tests/test_injury_backoff.py
@@ -0,0 +1,94 @@
+"""Host-side regression tests for the half-claw injury handoff."""
+import sys
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from state_machine import (
+    CargoAudit, CargoBatch, CompetitionMission, CompetitionSettings,
+    CompetitionState, PoseSnapshot, StmSnapshot, VisionSnapshot,
+)
+from protocol import CMD_CARGO_AUDIT
+
+
+class InjuryBackoffTests(unittest.TestCase):
+    def setUp(self):
+        self.mission = CompetitionMission(CompetitionSettings(
+            side="red", initial_stash_enabled=False))
+        self.mission.first_common_delivered = True
+        self.mission._select_batch(CargoBatch((1,), ("injured_orange",), "injury"))
+        self.mission._begin_post_grab_audit(VisionSnapshot(frame_sequence=1), 1.0)
+        self.pose = PoseSnapshot(True, 0.0, 0.0, 90.0, 5.0)
+        self.audit = CargoAudit(left_class="injured_orange", left_count=1, total_count=1)
+
+    def step(self, frame, mode, flags=1, pitch=14000, now=2.0, **kwargs):
+        return self.mission.step(
+            VisionSnapshot(frame_sequence=frame, capture_audit=self.audit),
+            self.pose, StmSnapshot(mode=mode, flags=flags, age_ms=5.0,
+                                  camera_pitch_cdeg=pitch, **kwargs), now)
+
+    def test_backoff_discards_first_audit_and_does_not_restart_epoch(self):
+        self.mission.audit_hits = 3
+        self.mission.pending_audit = self.audit
+        self.mission.grab_complete_confirmed = True
+        output = self.step(10, 49, flags=0, pitch=12000)
+        self.assertEqual(output.command.opcode, CMD_CARGO_AUDIT)
+        self.assertFalse(output.command.audit.stable)
+        self.assertIsNone(self.mission.pending_audit)
+        self.assertEqual(self.mission.audit_hits, 0)
+        self.assertFalse(self.mission.grab_complete_confirmed)
+        epoch = self.mission.audit_epoch
+        self.step(11, 49, flags=0, pitch=12000, now=2.1)
+        self.assertEqual(self.mission.audit_epoch, epoch)
+
+    def second_audit(self):
+        self.step(10, 49, flags=0, pitch=12000)
+        self.step(11, 23, flags=1, now=4.5)
+        self.assertEqual(self.mission.audit_hits, 0)
+        self.step(12, 23, now=4.6)
+        self.step(12, 23, now=4.61)
+        self.assertEqual(self.mission.audit_hits, 1)
+        self.step(13, 23, now=4.7)
+        self.step(14, 23, now=4.8)
+        self.assertEqual(self.mission.pending_audit_release_context, "post_grab_valid")
+
+    def test_second_audit_requires_new_distinct_frames(self):
+        self.second_audit()
+        self.assertFalse(self.mission.grab_complete_confirmed)
+
+    def test_reclose_preserves_audit_and_blocks_navigation_until_mode22(self):
+        self.second_audit()
+        audit = self.mission.pending_audit
+        out = self.step(15, 50, flags=48, now=4.9)
+        self.assertEqual(out.command.opcode, CMD_CARGO_AUDIT)
+        self.assertTrue(out.command.audit.stable)
+        self.assertIs(self.mission.pending_audit, audit)
+        self.assertFalse(self.mission.grab_complete_confirmed)
+        frame = out.command.to_frame(0)
+        result = self.step(
+            16, 22, flags=50, now=7.0, acknowledged_sequence=1,
+            relay_mission_tx_frames=1, relay_last_mission_command=frame[4],
+            relay_last_mission_payload=tuple(frame[4:12]))
+        self.assertEqual(result.event, "post_grab_audit_confirmed")
+        self.assertTrue(self.mission.grab_complete_confirmed)
+        self.assertEqual(self.mission.confirmed_delivery_destination, "injury")
+
+    def test_visibility_edge_clears_audit_even_at_same_camera_angle(self):
+        self.mission.post_grab_camera_ready = True
+        self.mission.audit_hits = 2
+        self.step(10, 23, flags=0)
+        self.assertEqual(self.mission.audit_hits, 0)
+        self.step(11, 23, flags=1, now=2.1)
+        self.assertEqual(self.mission.audit_hits, 0)
+
+    def test_quantity_policy_and_recovery_reset(self):
+        self.assertFalse(self.mission._audit_valid(CargoAudit(
+            left_class="injured_orange", left_count=2, total_count=2)))
+        self.assertFalse(self.mission._audit_valid(CargoAudit(
+            left_class="green_supply", left_count=2, total_count=2)))
+        self.mission._clear_selected_batch()
+        self.assertFalse(self.mission.injury_backoff_active)
+
+
+if __name__ == "__main__":
+    unittest.main()
