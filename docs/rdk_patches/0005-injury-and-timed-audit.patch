+"""Time-separated audit samples and conservative image-quality checks."""
+from dataclasses import dataclass
+
+
+@dataclass
+class TemporalAudit:
+    interval_s: float = 0.1
+    max_gap_s: float = 0.5
+    signature: tuple | None = None
+    last_frame: int = 0
+    last_evidence_s: float | None = None
+    last_sample_s: float | None = None
+    hits: int = 0
+
+    def reset(self):
+        self.signature = None
+        self.last_frame = 0
+        self.last_evidence_s = self.last_sample_s = None
+        self.hits = 0
+
+    def observe(self, frame: int, timestamp: float, signature: tuple) -> int:
+        if frame <= self.last_frame:
+            return self.hits
+        gap = None if self.last_evidence_s is None else timestamp - self.last_evidence_s
+        if signature != self.signature or gap is None or gap < 0 or gap > self.max_gap_s:
+            self.hits = 1
+            self.signature = signature
+            self.last_sample_s = timestamp
+        elif timestamp - self.last_sample_s + 1e-6 >= self.interval_s:
+            self.hits += 1
+            self.last_sample_s = timestamp
+        self.last_frame = frame
+        self.last_evidence_s = timestamp
+        return self.hits
+
+
+def audit_quality_reason(boxes, image_size=(1280, 1024), overlap_limit=0.35):
+    width, height = image_size
+    for x, y, w, h in boxes:
+        if w <= 0 or h <= 0 or x < 2 or y < 2 or x + w > width - 2 or y + h > height - 2:
+            return "capture_frame_clipped"
+    for i, (x, y, w, h) in enumerate(boxes):
+        for bx, by, bw, bh in boxes[i + 1:]:
+            intersection = max(0, min(x + w, bx + bw) - max(x, bx)) * max(
+                0, min(y + h, by + bh) - max(y, by))
+            if intersection / min(w * h, bw * bh) > overlap_limit:
+                return "capture_occluded"
+    return ""
