index 0000000..e84e03b
--- /dev/null
+++ b/competition_rescue/tests/test_audit_stability.py
@@ -0,0 +1,65 @@
+import sys
+import unittest
+from dataclasses import replace
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from audit_stability import TemporalAudit, audit_quality_reason
+import test_injury_backoff as injury_cases
+from state_machine import CargoAudit, CompetitionState, VisionSnapshot
+from protocol import CMD_ABORT, CMD_CARGO_AUDIT
+
+
+class AuditStabilityTests(unittest.TestCase):
+    setUp = injury_cases.InjuryBackoffTests.setUp
+    step = injury_cases.InjuryBackoffTests.step
+    second_audit = injury_cases.InjuryBackoffTests.second_audit
+    def test_fast_frames_need_time_span(self):
+        gate = TemporalAudit()
+        self.assertEqual(gate.observe(1, 0.0, ("injury",)), 1)
+        self.assertEqual(gate.observe(2, 0.01, ("injury",)), 1)
+        self.assertEqual(gate.observe(3, 0.02, ("injury",)), 1)
+        self.assertEqual(gate.observe(4, 0.1, ("injury",)), 2)
+        self.assertEqual(gate.observe(5, 0.2, ("injury",)), 3)
+        self.assertEqual(gate.observe(5, 1.0, ("injury",)), 3)
+        self.assertEqual(gate.observe(6, 1.01, ("injury",)), 1)
+
+    def test_quantity_same_but_class_changed_resets(self):
+        gate = TemporalAudit()
+        green = CargoAudit(left_class="green_supply", left_count=1, total_count=1)
+        core = replace(green, left_class="core_black")
+        a = self.mission._audit_signature_for_state(green, True)
+        b = self.mission._audit_signature_for_state(core, True)
+        self.assertNotEqual(a, b)
+        gate.observe(1, 0.0, a); gate.observe(2, 0.1, a)
+        self.assertEqual(gate.observe(3, 0.11, b), 1)
+
+    def test_quality_bad_is_not_empty_and_invalidates_pending(self):
+        self.second_audit()
+        self.assertIsNotNone(self.mission.pending_audit)
+        vision = VisionSnapshot(frame_sequence=15, capture_observation_valid=False,
+                                capture_observation_reason="capture_occluded")
+        from state_machine import StmSnapshot
+        result = self.mission.step(vision, self.pose, StmSnapshot(
+            mode=23, flags=49, age_ms=5.0, camera_pitch_cdeg=14000), 4.9)
+        self.assertIsNone(self.mission.pending_audit)
+        self.assertEqual(self.mission.audit_hits, 0)
+        self.assertEqual(result.command.opcode, CMD_CARGO_AUDIT)
+        self.assertFalse(result.command.audit.stable)
+        self.assertEqual(self.mission.state, CompetitionState.POST_GRAB_AUDIT)
+
+    def test_quality_geometry(self):
+        self.assertEqual(audit_quality_reason([(100, 300, 40, 40)]), "")
+        self.assertEqual(audit_quality_reason([(0, 300, 40, 40)]), "capture_frame_clipped")
+        self.assertEqual(audit_quality_reason([(100, 300, 40, 40), (110, 300, 40, 40)]), "capture_occluded")
+
+    def test_timeout_does_not_fake_audit_success(self):
+        self.step(1, 23, now=1.0)
+        result = self.step(2, 23, now=18.0)
+        self.assertEqual(result.command.opcode, CMD_ABORT)
+        self.assertEqual(result.state, CompetitionState.FAULT)
+        self.assertFalse(self.mission.grab_complete_confirmed)
+
+
+if __name__ == "__main__":
+    unittest.main()
